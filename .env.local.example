# ============================================================
# Google Apps Script (calendar feed)
# ============================================================
# Deployed at: script.google.com — runs as funmi@coderabbit.ai
# To add more CSM calendars, edit CALENDAR_IDS in Code.gs and redeploy.
# To rotate the secret: generate a new one, update both here and in the script.
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
APPS_SCRIPT_SECRET=

# ============================================================
# Google OAuth (user login — restricted to @coderabbit.ai)
# ============================================================
# Create at: console.cloud.google.com → APIs & Services → Credentials
# Add authorized redirect: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# NextAuth
# ============================================================
NEXTAUTH_SECRET=<run: openssl rand -base64 32>
NEXTAUTH_URL=https://csm-hub.coderabbit.ai

# ============================================================
# Salesforce (username-password OAuth flow)
# ============================================================
# Create a connected app in Salesforce Setup → Apps → App Manager
# Confirm exact field API names in Workbench: Setup → Developer → Workbench
# Fields needed on Account object: Next_Upcoming_Renewal__c, Next_Step_CS__c, CS_Next_Step_History__c
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com

# ============================================================
# Slack Bot
# ============================================================
# Create at: api.slack.com/apps → New App → From Scratch
# Bot token scopes: chat:write, im:write, users:read, users:read.email
# Install app to workspace, copy Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# ============================================================
# Upstash Redis (caching + coverage state)
# ============================================================
# Create at: console.upstash.com → Redis → Create Database
# Copy REST URL and token from the database dashboard
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Email (Resend)
# ============================================================
# Create at: resend.com → API Keys
# Add and verify coderabbit.ai domain in Resend dashboard
RESEND_API_KEY=re_
DIGEST_RECIPIENT=funmi@coderabbit.ai

# ============================================================
# Cron protection
# ============================================================
# Random secret to protect /api/digest from public trigger
CRON_SECRET=<run: openssl rand -base64 32>
